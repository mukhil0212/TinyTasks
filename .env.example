# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Nylas API Credentials
# ⚠️ SECURITY WARNING: Variables prefixed with EXPO_PUBLIC_ are bundled into the client app
# and are visible to anyone who inspects the JavaScript bundle.
EXPO_PUBLIC_NYLAS_API_KEY=your_nylas_api_key
EXPO_PUBLIC_NYLAS_CLIENT_ID=your_nylas_client_id

# ⚠️ CRITICAL SECURITY ISSUE: This client secret is currently exposed in client-side code!
# Client secrets should NEVER use the EXPO_PUBLIC_ prefix.
# This variable should be moved to a backend service and the OAuth token exchange
# should be performed server-side. See lib/nylasCalendar.ts for more details.
EXPO_PUBLIC_NYLAS_CLIENT_SECRET=your_nylas_client_secret

EXPO_PUBLIC_NYLAS_REDIRECT_URI=your_nylas_redirect_uri
